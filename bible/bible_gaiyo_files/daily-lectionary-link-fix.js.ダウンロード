/**
 * Daily Lectionary: RSSリンク末尾 "-2" 有無の揺れをクライアント側で補正する。
 *
 * 注意:
 * - 別オリジンURLは CORS が許可されていないと成否判定できない。
 * - 判定不能時は元の href を維持する（無害フォールバック）。
 */
(function () {
	'use strict';

	var ANCHOR_SELECTOR = '.rcj-daily-lectionary .rcj-inner-link__anchor[href]';
	var FIXED_ATTR = 'data-rcj-dl-url-fixed';
	var CHECK_TIMEOUT_MS = 3000;

	function withTimeoutFetch(url, options, timeoutMs) {
		var controller = new AbortController();
		var timer = window.setTimeout(function () {
			controller.abort();
		}, timeoutMs);

		return fetch(url, Object.assign({}, options, { signal: controller.signal }))
			.finally(function () {
				window.clearTimeout(timer);
			});
	}

	function buildToggledUrl(urlStr) {
		var parsed;
		try {
			parsed = new URL(urlStr, window.location.href);
		} catch (e) {
			return null;
		}

		var parts = parsed.pathname.split('/').filter(Boolean);
		if (!parts.length) {
			return null;
		}

		var last = parts[parts.length - 1];
		if (!last) {
			return null;
		}

		parts[parts.length - 1] = last.endsWith('-2') ? last.slice(0, -2) : last + '-2';
		if (!parts[parts.length - 1]) {
			return null;
		}

		parsed.pathname = '/' + parts.join('/') + '/';
		return parsed.toString();
	}

	function isReachable(url) {
		return withTimeoutFetch(
			url,
			{
				method: 'HEAD',
				mode: 'cors',
				cache: 'no-store',
				credentials: 'omit',
			},
			CHECK_TIMEOUT_MS
		)
			.then(function (res) {
				if (res && res.ok) {
					return true;
				}
				return withTimeoutFetch(
					url,
					{
						method: 'GET',
						mode: 'cors',
						cache: 'no-store',
						credentials: 'omit',
					},
					CHECK_TIMEOUT_MS
				).then(function (fallbackRes) {
					return !!(fallbackRes && fallbackRes.ok);
				});
			});
	}

	function fixAnchor(anchor) {
		if (!anchor || anchor.getAttribute(FIXED_ATTR) === '1') {
			return;
		}

		var originalHref = anchor.getAttribute('href');
		if (!originalHref) {
			anchor.setAttribute(FIXED_ATTR, '1');
			return;
		}

		var toggledHref = buildToggledUrl(originalHref);
		if (!toggledHref || toggledHref === originalHref) {
			anchor.setAttribute(FIXED_ATTR, '1');
			return;
		}

		Promise.allSettled([isReachable(originalHref), isReachable(toggledHref)])
			.then(function (results) {
				var originalOk = results[0].status === 'fulfilled' ? results[0].value : false;
				var toggledOk = results[1].status === 'fulfilled' ? results[1].value : false;

				if (!originalOk && toggledOk) {
					anchor.setAttribute('href', toggledHref);
				}
			})
			.catch(function () {
				// 判定不可時は元URLを維持する（無害フォールバック）。
			})
			.finally(function () {
				anchor.setAttribute(FIXED_ATTR, '1');
			});
	}

	function init() {
		var anchors = document.querySelectorAll(ANCHOR_SELECTOR);
		if (!anchors.length) {
			return;
		}
		anchors.forEach(fixAnchor);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}
})();
